#version 450

#extension GL_EXT_control_flow_attributes : require

// One workgroup per (token, stream). The workgroup folds the two streams together, normalises,
// projects the eight router logits, runs the twenty sinkhorn passes on a single lane, and writes
// the pre-weighted branch plus the gates into one packed buffer.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter {
    uint nb_a1; uint nb_a2;
    uint nb_a2_pad;
    uint nb_b1; uint nb_b2;
    uint nb_b2_pad;
    uint n_d; uint n_tok; uint n_str;
} pc;

layout(binding = 0, std430) readonly buffer A    { float data_a[]; };
layout(binding = 1, std430) readonly buffer B    { float data_b[]; };
layout(binding = 2, std430) readonly buffer Wt   { float data_w[]; };
layout(binding = 3, std430) readonly buffer Bias { float data_bias[]; };
layout(binding = 4, std430) buffer D { float data_d[]; };

shared float red[9][256];
shared float gates[8];

float sigmoidf(float x) { return 1.0f / (1.0f + exp(-x)); }

void main() {
    const uint lid = gl_LocalInvocationID.x;
    const uint t   = gl_WorkGroupID.x;
    const uint d   = pc.n_d;
    const uint n_s = pc.n_str;

    // stream 0 of this token; the other streams are reached with the s stride
    const uint off_a = t*pc.nb_a1;
    const uint off_b = t*pc.nb_b1;
    const uint off_d = t*(d + 6u);

    float acc0 = 0.0f, acc1 = 0.0f, acc2 = 0.0f, acc3 = 0.0f;
    float acc4 = 0.0f, acc5 = 0.0f, acc6 = 0.0f, acc7 = 0.0f;
    float ss   = 0.0f;

    for (uint i = lid; i < 2u*d; i += 256u) {
        const float v = (i < d) ? data_a[off_a + i] : data_b[off_b + i - d];
        ss += v*v;

        const uint wb = i;
        acc0 += data_w[0u*2u*d + wb]*v;
        acc1 += data_w[1u*2u*d + wb]*v;
        acc2 += data_w[2u*2u*d + wb]*v;
        acc3 += data_w[3u*2u*d + wb]*v;
        acc4 += data_w[4u*2u*d + wb]*v;
        acc5 += data_w[5u*2u*d + wb]*v;
        acc6 += data_w[6u*2u*d + wb]*v;
        acc7 += data_w[7u*2u*d + wb]*v;
    }

    red[0][lid] = ss;
    red[1][lid] = acc0; red[2][lid] = acc1; red[3][lid] = acc2; red[4][lid] = acc3;
    red[5][lid] = acc4; red[6][lid] = acc5; red[7][lid] = acc6; red[8][lid] = acc7;

    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lid < stride) {
            [[unroll]] for (uint k = 0u; k < 9u; ++k) {
                red[k][lid] += red[k][lid + stride];
            }
        }
        barrier();
    }

    if (lid == 0u) {
        const float rms = inversesqrt(red[0][0] / (2.0f*d) + 1e-6f);

        const float lg0 = red[1][0]*rms + data_bias[0];
        const float lg1 = red[2][0]*rms + data_bias[1];
        const float lg2 = red[3][0]*rms + data_bias[2];
        const float lg3 = red[4][0]*rms + data_bias[3];

        gates[0] = sigmoidf(lg0);
        gates[1] = sigmoidf(lg1);
        gates[2] = 2.0f*sigmoidf(lg2);
        gates[3] = 2.0f*sigmoidf(lg3);

        float m00 = red[5][0]*rms + data_bias[4];
        float m01 = red[6][0]*rms + data_bias[5];
        float m10 = red[7][0]*rms + data_bias[6];
        float m11 = red[8][0]*rms + data_bias[7];

        // twenty passes of row then column normalisation, in log space, exactly as trained
        for (uint it = 0u; it < 20u; ++it) {
            float mx  = max(m00, m01);
            float lse = mx + log(exp(m00 - mx) + exp(m01 - mx));
            m00 -= lse; m01 -= lse;

            mx  = max(m10, m11);
            lse = mx + log(exp(m10 - mx) + exp(m11 - mx));
            m10 -= lse; m11 -= lse;

            mx  = max(m00, m10);
            lse = mx + log(exp(m00 - mx) + exp(m10 - mx));
            m00 -= lse; m10 -= lse;

            mx  = max(m01, m11);
            lse = mx + log(exp(m01 - mx) + exp(m11 - mx));
            m01 -= lse; m11 -= lse;
        }

        gates[4] = exp(m00);
        gates[5] = exp(m01);
        gates[6] = exp(m10);
        gates[7] = exp(m11);
    }

    barrier();

    const float pre0 = gates[0];
    const float pre1 = gates[1];

    for (uint s = 0u; s < n_s; ++s) {
        const uint oa = off_a + s*pc.nb_a2;
        const uint ob = off_b + s*pc.nb_b2;
        const uint od = off_d + s*pc.n_tok*(d + 6u);

        for (uint i = lid; i < d; i += 256u) {
            data_d[od + i] = pre0*data_a[oa + i] + pre1*data_b[ob + i];
        }

        if (lid == 0u) {
            data_d[od + d + 0u] = gates[2];
            data_d[od + d + 1u] = gates[3];
            data_d[od + d + 2u] = gates[4];
            data_d[od + d + 3u] = gates[5];
            data_d[od + d + 4u] = gates[6];
            data_d[od + d + 5u] = gates[7];
        }
    }
}
